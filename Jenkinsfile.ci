pipeline {
    agent none

    options { 
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10')) 
        disableConcurrentBuilds() 
        timestamps()
        skipDefaultCheckout(true)
    }  

    environment {
        PROJECT_ID = "q-gcp-00098-trell-snd-bx-26-04"
        Q_PROJECT_ID = "q-gcp-40701-gke-images-23-10"
        Q_REGION = "us"
        REPO_NAME = "container-images-q-gcp-00098-trell-snd-bx-26-04"
        IMAGE_BASE = "${Q_REGION}-docker.pkg.dev/${Q_PROJECT_ID}/${REPO_NAME}"

        IMAGE_TAG = "ci-${BUILD_NUMBER}"
        BACKEND_IMAGE = "${IMAGE_BASE}/backend:${IMAGE_TAG}"
        FRONTEND_IMAGE = "${IMAGE_BASE}/frontend:${IMAGE_TAG}"

        USER_ACCOUNT = "ujjwal.aggarwal@quantiphi.com"
        JENKINS_AR_SA = "jenkins-artifact-sa@q-gcp-00098-trell-snd-bx-26-04.iam.gserviceaccount.com"
    }

    stages {
        stage('Checkout Code') {
            agent { label 'docker' }

            steps {
                checkout scm

                sh '''
                echo "Checkout completed."
                pwd
                ls -la
                '''

                stash name: 'source-code', includes: '**/*'
            }
        }

        stage('Validate Workspace and Tools') {
            agent { label 'docker' }

            steps {
                unstash 'source-code'

                sh '''
                set -e

                echo "Current workspace:"
                pwd

                echo "Repository files:"
                ls -la

                echo "Backend folder:"
                ls -la backend

                echo "Frontend folder:"
                ls -la frontend

                echo "Tool versions:"
                whoami
                git --version
                docker --version
                gcloud --version

                echo "Active gcloud account:"
                gcloud auth list

                echo "Current GCP project:"
                gcloud config get-value project
                '''
            }
        }

        stage('Configure Docker Auth') {
            agent { label 'docker' }

            steps {
                sh '''
                set -e

                echo "Setting active gcloud account..."
                gcloud config set account "$USER_ACCOUNT"

                echo "Active gcloud account:"
                gcloud auth list

                echo "Logging in Docker to Artifact Registry using impersonated service account token..."
                set +x
                gcloud auth print-access-token \
                  --impersonate-service-account="$JENKINS_AR_SA" | docker login \
                  -u oauth2accesstoken \
                  --password-stdin https://us-docker.pkg.dev
                set -x

                echo "Docker login completed for us-docker.pkg.dev"
                '''
            }
        }

        stage('Build Docker Images') {
            agent { label 'docker' }

            steps {
                unstash 'source-code'

                sh '''
                set -e

                echo "Building backend image using Docker cache where possible:"
                echo "$BACKEND_IMAGE"
                docker build --pull -t "$BACKEND_IMAGE" ./backend

                echo "Building frontend image using Docker cache where possible:"
                echo "$FRONTEND_IMAGE"
                docker build --pull -t "$FRONTEND_IMAGE" ./frontend
                '''
            }
        }

        stage('Push Images to Artifact Registry') {
            agent { label 'docker' }

            steps {
                sh '''
                set -e

                echo "Pushing backend image..."
                docker push "$BACKEND_IMAGE"

                echo "Pushing frontend image..."
                docker push "$FRONTEND_IMAGE"
                '''
            }
        }

        stage('Print Image Paths') {
            agent { label 'docker' }

            steps {
                sh '''
                echo "Backend Image: $BACKEND_IMAGE"
                echo "Frontend Image: $FRONTEND_IMAGE"
                echo "Image Tag: $IMAGE_TAG"
                '''
            }
        }
    }

    post {
        success {
            echo "CI pipeline completed successfully."
            echo "Backend image: ${env.BACKEND_IMAGE}"
            echo "Frontend image: ${env.FRONTEND_IMAGE}"
        }

        failure {
            echo "CI pipeline failed. Check the failed stage above."
        }

        always {
            node('docker') {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
            }
        }
    }
}
